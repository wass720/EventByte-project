# Application Configuration
# Set to "demo" to use fake data adapters, "production" to use real adapters
VITE_CONFIG_MODE=demo

# Backend URL (production mode only). The Spring Boot backend listens on 8080 by default.
VITE_API_URL=http://localhost:8080

# Keycloak Configuration
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=eventbyte
VITE_KEYCLOAK_CLIENT_ID=web-app

# Stripe Configuration
# Public key for demo booking payments starts with pk_test_...
VITE_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# Client secret for demo booking payments (starts with pi_...)
# In demo mode, this is used as the payment intent client secret for all bookings
VITE_STRIPE_CLIENT_SECRET=your_stripe_client_secret_here
